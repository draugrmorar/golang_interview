func ItemFromEnd(k int, head *Item) interface{} {
    if head == nil {
        return nil
    }
    
    // Два указателя
    fast := head
    slow := head
    
    // Двигаем fast на k шагов вперед
    for i := 0; i < k; i++ {
        if fast == nil {
            return nil // список короче k
        }
        fast = fast.next
    }
    
    // Если fast уже nil, значит k == длине списка -> нужно вернуть голову
    if fast == nil {
        return slow.value
    }
    
    // Двигаем оба указателя, пока fast не дойдет до конца
    for fast.next != nil {
        fast = fast.next
        slow = slow.next
    }
    
    // Теперь slow указывает на элемент за k шагов от конца
    return slow.value
}




func ItemFromEnd(k int, head *Item) interface{} {
    if head == nil {
        return nil
    }

    // 1. Считаем длину списка
    length := 0
    current := head
    for current != nil {
        length++
        current = current.next
    }

    // 2. Проверяем, что k не выходит за границы
    if k >= length {
        return nil
    }

    // 3. Находим индекс элемента с начала
    indexFromStart := length - k - 1
    current = head
    for i := 0; i < indexFromStart; i++ {
        current = current.next
    }

    return current.value
}