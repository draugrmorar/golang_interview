package main

import (
    "fmt"
    "net/http"
    "sync"
)

func callRequestsForURLs(urls []string, k int) []*http.Response {
    if k <= 0 {
        return nil
    }
    
    var wg sync.WaitGroup
    // Канал-семафор: буфер размером k
    // Вмещает не больше k "занятых слотов"
    sem := make(chan struct{}, k)
    
    // Канал для сбора результатов (буфер = количество URL-ов)
    results := make(chan *http.Response, len(urls))
    
    // Запускаем горутину для каждого URL
    for _, url := range urls {
        wg.Add(1)
        go func(url string) {
            defer wg.Done()
            
            // Захватываем слот в семафоре (блокируется, если уже k активных)
            sem <- struct{}{}
            defer func() { <-sem }() // Освобождаем слот
            
            // Делаем запрос
            resp, err := http.Get(url)
            if err != nil {
                // В реальном коде логируем ошибку
                fmt.Printf("Error fetching %s: %v\n", url, err)
                results <- nil
                return
            }
            results <- resp
        }(url) // Важно! Передаем url, чтобы избежать замыкания
    }
    
    // Ждем завершения всех горутин
    go func() {
        wg.Wait()
        close(results) // Закрываем канал результатов
    }()
    
    // Собираем все ответы в слайс
    var responses []*http.Response
    for resp := range results {
        responses = append(responses, resp)
    }
    
    return responses
}






